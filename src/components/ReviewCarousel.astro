---
import { publicReviewSummaries } from '../data/site.js';
---
<div class="review-carousel" data-review-carousel>
  <div class="review-track" data-review-track>
    {publicReviewSummaries.map((review, i) => (
      <article class:list={['review-slide', { active: i === 0 }]} data-review-slide aria-hidden={i === 0 ? 'false' : 'true'}>
        <div class="review-stars" aria-label="5 stars">★★★★★</div>
        <blockquote>{review.quote}</blockquote>
        <footer>
          <strong>{review.name}</strong>
          <span>{review.label}</span>
        </footer>
      </article>
    ))}
  </div>
  <div class="review-controls" aria-label="Review carousel controls">
    <span class="review-count">Customer feedback</span>
    <div>
      {publicReviewSummaries.map((_, i) => <button class:list={{ active: i === 0 }} type="button" aria-label={`Show review ${i + 1}`} data-review-dot={i}>{String(i + 1).padStart(2, '0')}</button>)}
    </div>
  </div>
</div>
<script>
  const carousels = document.querySelectorAll('[data-review-carousel]');

  carousels.forEach((carousel) => {
    const track = carousel.querySelector('[data-review-track]');
    const slides = [...carousel.querySelectorAll('[data-review-slide]')];
    const dots = [...carousel.querySelectorAll('[data-review-dot]')];
    if (!track || !slides.length) return;

    let current = 0;
    let timer;
    let resizeTimer;

    const measureTrack = () => {
      const tallest = Math.ceil(Math.max(...slides.map((slide) => slide.scrollHeight)));
      const currentHeight = parseFloat(getComputedStyle(carousel).getPropertyValue('--review-track-height')) || 0;
      if (Math.abs(tallest - currentHeight) > 1) {
        carousel.style.setProperty('--review-track-height', `${tallest}px`);
      }
    };

    const show = (next) => {
      current = next;
      slides.forEach((slide, index) => {
        const active = index === current;
        slide.classList.toggle('active', active);
        slide.setAttribute('aria-hidden', active ? 'false' : 'true');
      });
      dots.forEach((dot, index) => dot.classList.toggle('active', index === current));
    };

    const stop = () => window.clearInterval(timer);
    const play = () => {
      stop();
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      timer = window.setInterval(() => show((current + 1) % slides.length), 7000);
    };

    dots.forEach((dot, index) => dot.addEventListener('click', () => {
      show(index);
      play();
    }));

    carousel.addEventListener('mouseenter', stop);
    carousel.addEventListener('mouseleave', play);
    carousel.addEventListener('focusin', stop);
    carousel.addEventListener('focusout', play);

    let touchStartX = 0;
    carousel.addEventListener('touchstart', (event) => {
      touchStartX = event.touches[0]?.clientX ?? 0;
      stop();
    }, { passive: true });
    carousel.addEventListener('touchend', (event) => {
      const endX = event.changedTouches[0]?.clientX ?? touchStartX;
      const delta = endX - touchStartX;
      if (Math.abs(delta) > 45) {
        show(delta < 0 ? (current + 1) % slides.length : (current - 1 + slides.length) % slides.length);
      }
      play();
    }, { passive: true });

    measureTrack();
    document.fonts?.ready?.then(measureTrack);
    window.addEventListener('load', measureTrack, { once: true });
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(measureTrack, 120);
    });

    play();
  });
</script>
