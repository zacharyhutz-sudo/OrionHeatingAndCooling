---
import BrandMark from './BrandMark.astro';
import { nav, site, withBase } from '../data/site.js';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <BrandMark class="footer-logo" />
      <p>Heating, cooling and home-energy service for Oconee County and surrounding communities.</p>
    </div>

    <nav class="footer-nav" aria-label="Footer navigation">
      {nav.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
    </nav>

    <div class="footer-contact">
      <a href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <span>{site.serviceArea}</span>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {year} Orion Heating & Cooling</span>
    <span>Licensed · Insured · Family-owned · GA Conditioned Air License · GA#- CR110697</span>
  </div>
</footer>
<div class="mobile-callbar">
  <a href={`tel:${site.phoneHref}`}>Call Orion</a>
  <a href={withBase('contact')}>Request service</a>
</div>
