---
import Icon from './Icon.astro';
import { site, withBase } from '../data/site.js';
const { compact = false } = Astro.props;
---
<form class:list={['contact-form', { compact }]} action={site.formsparkAction} method="POST">
  <input type="hidden" name="_redirect" value={`${withBase('contact')}?success=1`} />
  <div class="form-row">
    <label>First name <span>*</span><input name="first_name" type="text" autocomplete="given-name" required /></label>
    <label>Last name<input name="last_name" type="text" autocomplete="family-name" /></label>
  </div>
  <div class="form-row">
    <label>Phone <span>*</span><input name="phone" type="tel" autocomplete="tel" required /></label>
    <label>Email<input name="email" type="email" autocomplete="email" /></label>
  </div>
  <label>Service needed
    <select name="service">
      <option value="">Choose a service</option>
      <option>Heating</option>
      <option>Cooling</option>
      <option>Energy assessment</option>
      <option>Maintenance</option>
      <option>Not sure / other</option>
    </select>
  </label>
  <label>How can we help? <span>*</span><textarea name="message" rows={compact ? 4 : 5} required placeholder="Tell us what you're noticing in your home..."></textarea></label>
  <button class="btn btn-primary form-submit" type="submit">Request Service <Icon name="arrow" size={18} /></button>
  <p class="form-note">Prefer to talk? Call <a href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a>.</p>
</form>
