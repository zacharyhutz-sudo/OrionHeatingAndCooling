---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import BrandMark from '../components/BrandMark.astro';
import { publicReviewSummaries, withBase } from '../data/site.js';
---
<BaseLayout title="About & Reviews | Orion Heating & Cooling" description="Meet Jeremiah and Calina Jordan, the husband-and-wife team behind Orion Heating & Cooling, and learn about Orion's HVAC and home-energy approach.">
  <section class="page-hero editorial-page-hero">
    <div class="container page-hero-grid">
      <p class="section-index">About Orion</p>
      <div>
        <h1>Local service with a whole-home point of view.</h1>
        <p>Orion was created to help homeowners understand their homes, make confident decisions and invest in comfort that lasts.</p>
      </div>
    </div>
  </section>

  <section class="section owner-story">
    <div class="container owner-grid">
      <div class="owner-placeholder">
        <BrandMark variant="icon" class="owner-mark" />
        <div>
          <span>Owner photo</span>
          <strong>Jeremiah & Calina Jordan</strong>
          <p>Replace this panel with the client's preferred original photo when supplied.</p>
        </div>
      </div>
      <div class="owner-copy">
        <p class="section-index">01 / The owners</p>
        <h2>Jeremiah & Calina Jordan</h2>
        <p>Orion Heating & Cooling was founded in February 2025 by husband-and-wife team Jeremiah and Calina Jordan with a simple goal: help homeowners create more comfortable, energy-efficient homes through trusted HVAC services and professional energy audits.</p>
        <p>Jeremiah leads the technical work with more than 10 years of HVAC experience. He holds a Georgia HVAC license and is BPI certified, giving him training to evaluate both heating and cooling equipment and the way the home itself uses energy.</p>
        <p>That combination supports Orion's focus on honest insight, reliable service and practical solutions that improve comfort, efficiency and long-term system performance.</p>
      </div>
    </div>
  </section>

  <section class="section values-section editorial-muted">
    <div class="container values-editorial-grid">
      <div>
        <p class="section-index">02 / The approach</p>
        <h2>Good service starts with understanding the problem.</h2>
      </div>
      <div class="value-list">
        <article><span>01</span><div><h3>Find the root cause</h3><p>Look beyond the immediate symptom to understand equipment, airflow and whole-home performance.</p></div></article>
        <article><span>02</span><div><h3>Explain the options</h3><p>Give homeowners straightforward information so they can make smart decisions for their home and budget.</p></div></article>
        <article><span>03</span><div><h3>Build for the long term</h3><p>Prioritize dependable comfort and efficiency instead of temporary fixes.</p></div></article>
      </div>
    </div>
    <div class="container credential-row">
      <div><strong>10+</strong><span>Years HVAC experience</span></div>
      <div><strong>GA</strong><span>HVAC licensed</span></div>
      <div><strong>BPI</strong><span>Certified</span></div>
      <div><strong>LOCAL</strong><span>Family-owned</span></div>
    </div>
  </section>

  <section class="section reviews-archive" id="reviews">
    <div class="container reviews-archive-head">
      <p class="section-index">03 / Reviews</p>
      <div><h2>Five-star feedback.</h2><p>The first draft uses careful summaries of publicly indexed feedback rather than inventing testimonial quotes.</p></div>
    </div>
    <div class="container review-list-editorial">
      {publicReviewSummaries.map((review, i) => (
        <article>
          <span class="review-number">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <div class="stars warm">★★★★★</div>
            <blockquote>{review.quote}</blockquote>
            <footer><strong>{review.name}</strong><span>{review.label}</span></footer>
          </div>
        </article>
      ))}
    </div>
    <div class="container review-draft-note"><Icon name="star" size={18} /><span><strong>Before launch:</strong> replace these summaries with the exact Google reviews the client wants featured.</span></div>
  </section>

  <section class="section cta-panel-section">
    <div class="container cta-panel editorial-cta">
      <div><p class="section-index light">Ready when you are</p><h2>Let's make your home more comfortable.</h2></div>
      <a class="btn btn-light" href={withBase('contact')}>Request service</a>
    </div>
  </section>
</BaseLayout>
