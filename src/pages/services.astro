---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { services, withBase } from '../data/site.js';
---
<BaseLayout title="HVAC & Energy Services | Orion Heating & Cooling" description="Heating repair, cooling repair, HVAC installation, maintenance and home-energy assessments serving Oconee County and surrounding areas.">
  <section class="page-hero editorial-page-hero">
    <div class="container page-hero-grid">
      <p class="section-index">Services</p>
      <div>
        <h1>Heating, cooling and energy solutions for the whole home.</h1>
        <p>From repairs and replacement to home-energy assessments, Orion starts with what is actually happening in your home and recommends the next step from there.</p>
        <a class="btn btn-primary" href={withBase('contact')}>Request service</a>
      </div>
    </div>
  </section>

  <section class="section service-detail-section">
    <div class="container service-detail-stack">
      {services.map((service, i) => (
        <article id={service.icon === 'energy' ? 'energy' : undefined} class={`service-detail ${service.icon}`}>
          <header class="service-detail-head">
            <span class="service-detail-number">0{i + 1}</span>
            <div>
              <span class="service-accent" aria-hidden="true"></span>
              <p class="kicker">{service.eyebrow}</p>
              <h2>{service.title}</h2>
            </div>
          </header>
          <div class="service-detail-grid">
            <div class="service-description">
              <p class="lead">{service.description}</p>
              <h3>Common concerns</h3>
              <ul class="plain-list">
                {service.problems.map((problem) => <li>{problem}</li>)}
              </ul>
            </div>
            <div class="service-scope">
              <p class="kicker">How Orion helps</p>
              {service.icon === 'heat' && <><h3>Heating service without guesswork.</h3><p>Orion evaluates heating performance, explains what is happening and recommends repair, maintenance or replacement based on the condition of the system and the needs of the home.</p><ul class="plain-list"><li>Heating diagnostics & repair</li><li>System replacement & installation</li><li>Preventative maintenance</li><li>Airflow & comfort troubleshooting</li></ul></>}
              {service.icon === 'cool' && <><h3>Practical cooling solutions for Georgia homes.</h3><p>From an A/C that will not keep up to recurring comfort issues, Orion looks at operation, airflow and efficiency before recommending the next step.</p><ul class="plain-list"><li>A/C diagnostics & repair</li><li>System replacement & installation</li><li>Preventative maintenance</li><li>Humidity & airflow troubleshooting</li></ul></>}
              {service.icon === 'energy' && <><h3>Look beyond the HVAC unit.</h3><p>A home-energy assessment can uncover air leakage, insufficient insulation, duct problems and inefficient system operation that equipment replacement alone may not solve.</p><ul class="plain-list"><li>Home-energy assessments</li><li>Air-leakage evaluation</li><li>Insulation & building-envelope review</li><li>Duct and HVAC performance evaluation</li></ul></>}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section symptom-section editorial-muted">
    <div class="container symptom-editorial-grid">
      <div>
        <p class="section-index">Not sure what you need?</p>
        <h2>Start with what you are experiencing.</h2>
        <p>You do not need to diagnose the system before calling. Tell Orion what you see, hear or feel.</p>
        <a class="btn btn-primary" href={withBase('contact')}>Tell us what is going on</a>
      </div>
      <div class="symptom-editorial-list">
        {['My power bill is too high','My A/C runs constantly','Some rooms are hotter or colder','My system keeps breaking down','My home feels humid','My HVAC system is getting old'].map((item, i) => <div><span>{String(i + 1).padStart(2, '0')}</span><strong>{item}</strong></div>)}
      </div>
    </div>
  </section>
</BaseLayout>
