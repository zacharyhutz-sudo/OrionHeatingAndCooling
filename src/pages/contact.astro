---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site.js';
const success = Astro.url.searchParams.get('success') === '1';
const formError = Astro.url.searchParams.get('form_error') === '1';
---
<BaseLayout title="Contact Orion Heating & Cooling | Request HVAC Service" description="Request heating, cooling or home-energy service from Orion Heating & Cooling in Oconee County and surrounding areas.">
  <section class="page-hero editorial-page-hero contact-page-hero">
    <div class="container page-hero-grid">
      <p class="section-index">Contact</p>
      <div>
        <h1>Tell us what your home is doing.</h1>
        <p>Share what you are noticing and how to reach you. Orion can help determine the next best step.</p>
      </div>
    </div>
  </section>

  <section class="section contact-page-section">
    <div class="container contact-page-grid">
      <aside class="contact-info-panel">
        <p class="section-index">Get in touch</p>
        <h2>Local help is one call away.</h2>
        <p>Serving homeowners across Oconee County and surrounding communities with heating, cooling and energy solutions.</p>
        <div class="contact-methods">
          <a href={`tel:${site.phoneHref}`}><span>Phone</span><strong>{site.phoneDisplay}</strong></a>
          <a href={`mailto:${site.email}`}><span>Email</span><strong>{site.email}</strong></a>
          <div><span>Service area</span><strong>{site.serviceArea}</strong></div>
        </div>
        <p class="contact-trust-line">Licensed · Insured · Family-owned · 10+ years HVAC experience</p>
      </aside>
      <div class="contact-form-card">
        {success && <div class="success-message"><Icon name="check" size={20} /><div><strong>Thanks for reaching out.</strong><span>Your request was submitted.</span></div></div>}
        {formError && <div class="form-error-message" role="alert"><div><strong>Something went wrong.</strong><span>Your request may not have been sent. Please try again or call Orion directly.</span></div></div>}
        <p class="section-index">Request service</p>
        <h2>How can Orion help?</h2>
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>
