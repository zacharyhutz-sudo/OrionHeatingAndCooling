---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import BrandMark from '../components/BrandMark.astro';
import ReviewCarousel from '../components/ReviewCarousel.astro';
import ContactForm from '../components/ContactForm.astro';
import { services, site, withBase } from '../data/site.js';
---
<BaseLayout title="Orion Heating & Cooling | Oconee County, GA" description="Orion Heating & Cooling provides local HVAC repair, installation, maintenance and home-energy assessments for Oconee County and surrounding areas.">
  <section class="hero editorial-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="kicker">Orion Heating & Cooling · Oconee County, Georgia</p>
        <h1>Comfort, handled properly.</h1>
        <p class="hero-lead">Heating, cooling and home-energy service from a local team focused on clear answers, dependable work and long-term comfort.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={withBase('contact')}>Request service</a>
          <a class="text-action" href={`tel:${site.phoneHref}`}><Icon name="phone" size={17} /> {site.phoneDisplay}</a>
        </div>
      </div>

      <aside class="hero-aside" aria-label="Orion service overview">
        <BrandMark variant="icon" class="hero-mark" />
        <div class="hero-aside-copy">
          <p>Licensed · Insured · Family-owned</p>
          <p>10+ years of HVAC experience</p>
          <p>Georgia HVAC license + BPI certified</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section intro-strip">
    <div class="container intro-strip-grid">
      <p class="section-index">01 / Services</p>
      <div>
        <h2>Heating, cooling and energy expertise under one roof.</h2>
        <p>Orion combines practical HVAC experience with whole-home building-performance knowledge, so recommendations are based on what your home actually needs.</p>
      </div>
    </div>
  </section>

  <section class="services-editorial">
    <div class="container service-list">
      {services.map((service, i) => (
        <article class={`service-row ${service.icon}`}>
          <div class="service-number">0{i + 1}</div>
          <div class="service-title">
            <span class="service-accent" aria-hidden="true"></span>
            <h3>{service.eyebrow}</h3>
          </div>
          <p>{service.description}</p>
          <a class="arrow-link" href={withBase('services')} aria-label={`Learn more about ${service.eyebrow}`}>Learn more <Icon name="arrow" size={16} /></a>
        </article>
      ))}
    </div>
  </section>

  <section class="section root-cause-section">
    <div class="container root-cause-grid">
      <div class="root-cause-heading">
        <p class="section-index">02 / Whole-home comfort</p>
        <h2>The equipment is only part of the picture.</h2>
      </div>
      <div class="root-cause-copy">
        <p>High utility bills, uneven temperatures and a system that runs constantly can point to more than one issue. Air leakage, insulation, ducts, airflow and equipment all work together.</p>
        <p>Orion looks for the cause before recommending the fix.</p>
        <a class="arrow-link strong" href={`${withBase('services')}#energy`}>Explore energy solutions <Icon name="arrow" size={16} /></a>
      </div>
      <div class="symptom-list-home">
        <div><span>01</span><p>Rooms that never stay comfortable</p></div>
        <div><span>02</span><p>Power bills that keep climbing</p></div>
        <div><span>03</span><p>A system that runs constantly</p></div>
      </div>
    </div>
  </section>

  <section class="section about-preview">
    <div class="container about-editorial-grid">
      <div class="about-brand-panel">
        <BrandMark variant="icon" class="about-mark" />
        <p>Serving Oconee County and surrounding communities.</p>
      </div>
      <div class="about-copy">
        <p class="section-index">03 / About Orion</p>
        <h2>A local company built around straightforward service.</h2>
        <p>Founded in 2025 by husband-and-wife team Jeremiah and Calina Jordan, Orion Heating & Cooling helps homeowners make informed decisions about comfort, HVAC performance and energy use.</p>
        <p>Jeremiah brings more than a decade of industry experience, a Georgia HVAC license and BPI certification to the work.</p>
        <a class="arrow-link strong" href={withBase('about')}>Meet Jeremiah & Calina <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>

  <section class="section reviews-section">
    <div class="container reviews-editorial-grid">
      <div class="reviews-intro">
        <p class="section-index">04 / Reviews</p>
        <h2>Good work should speak for itself.</h2>
        <p>Orion's public feedback consistently points to responsive communication, transparent pricing and straightforward service.</p>
        <a class="arrow-link strong" href={`${withBase('about')}#reviews`}>View customer feedback <Icon name="arrow" size={16} /></a>
      </div>
      <ReviewCarousel />
    </div>
  </section>

  <section class="section contact-band">
    <div class="container contact-band-grid">
      <div class="contact-band-copy">
        <p class="section-index light">05 / Request service</p>
        <h2>Tell us what is going on.</h2>
        <p>Share the symptoms, how to reach you and what kind of service you may need. Orion will take it from there.</p>
        <div class="contact-direct">
          <a href={`tel:${site.phoneHref}`}><span>Phone</span><strong>{site.phoneDisplay}</strong></a>
          <a href={`mailto:${site.email}`}><span>Email</span><strong>{site.email}</strong></a>
        </div>
      </div>
      <div class="contact-band-form">
        <ContactForm compact={true} />
      </div>
    </div>
  </section>
</BaseLayout>
